AOTS_APP_NAME=AOTS Paper Trading
AOTS_ENVIRONMENT=development
AOTS_BROKER=groww
AOTS_TRADING_MODE=paper
AOTS_UNDERLYING=NIFTY
AOTS_CAPITAL_INR=100000
AOTS_MAX_DAILY_LOSS_PCT=0.02
AOTS_MAX_TRADE_RISK_PCT=0.005
AOTS_MAX_CONSECUTIVE_LOSSES=3
AOTS_MAX_OPEN_POSITIONS=3
AOTS_MAX_LOTS_PER_ORDER=1
AOTS_MARKET_DATA_MAX_AGE_SECONDS=5
AOTS_SQUARE_OFF_TIME=15:15
AOTS_DATABASE_PATH=./data/aots.db
# Live execution is intentionally unsupported in this starter. Keep false.
AOTS_LIVE_TRADING_ENABLED=false
# Reserved for future Groww read-only integration; do not commit secrets.
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=
